# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rideconnect?retryWrites=true&w=majority"

# Public site URL (used for SEO, sitemap, share links)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret token protecting cron + admin routes (e.g. Vercel Cron header)
CRON_SECRET="change-me-in-production"

# Comma-separated admin phone numbers (device-based v1 admin allowlist)
ADMIN_PHONES="+923001234567"
