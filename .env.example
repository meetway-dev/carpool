# MongoDB Atlas connection string
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rideconnect?retryWrites=true&w=majority"

# Public site URL (used for SEO, sitemap, share links)
# In production (Vercel), set this to your real domain, e.g. https://citypool.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Secret token protecting cron + admin routes (e.g. Vercel Cron header)
CRON_SECRET="change-me-in-production"

# Cookie secret used to sign auth session tokens
AUTH_COOKIE_SECRET="change-me-in-production"

# Google OAuth credentials for sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/google"

# Comma-separated admin phone numbers (device-based v1 admin allowlist)
ADMIN_PHONES="+923001234567"
